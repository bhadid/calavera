# Copy to .env and adjust. Nothing secret belongs in this file.

# Address the web UI is published on. Use this host's LAN IP, or 127.0.0.1.
# The UI has no login of its own: never publish it on a public interface.
BIND_ADDRESS=127.0.0.1

# Port of the web UI on the host.
WEB_PORT=8080

# Your music library. Finished albums are copied to <LIBRARY_PATH>/<Artist>/<Album>/.
# Existing content is never overwritten, renamed or deleted.
LIBRARY_PATH=/path/to/music/library

# Scratch space for downloads in progress (an album is a few hundred MB to a
# few GB). Emptied after each successful import.
STAGING_PATH=./data/staging

# Timezone (tz database name).
TZ=Europe/Berlin

# Owner of the files written to the library (`id -u` / `id -g`).
PUID=1000
PGID=1000
